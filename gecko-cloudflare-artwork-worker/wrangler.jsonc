{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gecko-artwork-upload",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_ASSET_BASE_URL": "https://assets.example.com"
  },
  "r2_buckets": [
    {
      "binding": "ARTWORK_BUCKET",
      "bucket_name": "gecko-artwork"
    }
  ]
}
