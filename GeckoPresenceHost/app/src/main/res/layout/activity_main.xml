<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="-0.05"
                android:text="GPB//"
                android:textColor="@color/accent_cyan"
                android:textSize="29sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp"
                android:text="SIGNAL DECK / 05"
                android:textColor="@color/screen_bg"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="ANDROID ACTIVITY CONTROLLER"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.16"
                android:text="LIVE PRESENCE / LOCAL FIRST"
                android:textColor="@color/screen_bg"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.06"
                android:lineSpacingExtra="-4dp"
                android:text="MAKE YOUR\nACTIVITY LOUD."
                android:textColor="@color/screen_bg"
                android:textSize="31sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:text="ANDROID APPS  +  FIREFOX / GECKO"
                android:textColor="#272400"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="01  /  LIVE SIGNAL"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="LOCAL BRIDGE"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtBridgeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="STOPPED"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="9dp"
                android:background="@color/line" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="DISCORD SOCIAL SDK"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtDiscordStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="AUTH REQUIRED"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/txtSdkInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:text="Checking Discord SDK configuration…"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/txtApplicationId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="monospace"
                android:text="APP ID / NOT CONFIGURED"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp" />
            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:minHeight="48dp"
                android:text="CONNECT DISCORD"
                android:textColor="@color/screen_bg"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_button_outline"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="DISCONNECT DISCORD"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="02  /  BRIDGE ROUTING"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="127.0.0.1 : 32145"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="LOOPBACK ONLY  /  NOT EXPOSED TO WI-FI"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:fontFamily="monospace"
                    android:text="START"
                    android:textColor="@color/screen_bg"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <View android:layout_width="8dp" android:layout_height="1dp" />
                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_outline"
                    android:fontFamily="monospace"
                    android:text="STOP"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/txtPresencePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_preview"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:text="WAITING FOR ACTIVITY…"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="03  /  ANDROID SOURCES"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">
            <Switch
                android:id="@+id/switchTrackApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="TRACK SELECTED ANDROID APPS"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtAppTrackingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:text="Usage Access: not granted"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <Button
                android:id="@+id/btnCopyAppDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_outline"
                android:fontFamily="monospace"
                android:text="COPY DETECTOR DIAGNOSTICS"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnChooseApps"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:fontFamily="monospace"
                    android:text="CHOOSE APPS / 0"
                    android:textColor="@color/screen_bg"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <View android:layout_width="8dp" android:layout_height="1dp" />
                <Button
                    android:id="@+id/btnCustomizeApps"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_outline"
                    android:fontFamily="monospace"
                    android:text="CUSTOM RULES"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="7dp"
                android:background="@color/line" />
            <Switch
                android:id="@+id/switchShareTitles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="SHARE MEDIA TITLES TO DISCORD"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Single title-sharing control for browser media. Titles are only collected while a media element is playing, paused or ended."
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="04  /  BROWSER MODULE"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="ONE APK / OPTIONAL FIREFOX ADD-ON"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="The browser module is bundled inside this app. Export an XPI only when you want Firefox or Tor Browser website detection. Android app tracking works without the add-on."
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <Button
                android:id="@+id/btnExportExtension"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="monospace"
                android:text="EXPORT FIREFOX XPI"
                android:textColor="@color/screen_bg"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="XPI EXPORT IS UNSIGNED  /  AMO SIGNING REQUIRED FOR NORMAL FIREFOX"
                android:textColor="@color/accent_cyan"
                android:textSize="9sp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="@color/line" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOCAL PAIRING KEY"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtPairingKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:text="••••••••••••••••••••••••••••••••••••••••••••"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="10sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnRevealKey"
                    android:layout_width="0dp"
                    android:layout_height="43dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_outline"
                    android:fontFamily="monospace"
                    android:text="REVEAL"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <View android:layout_width="7dp" android:layout_height="1dp" />
                <Button
                    android:id="@+id/btnCopyKey"
                    android:layout_width="0dp"
                    android:layout_height="43dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:fontFamily="monospace"
                    android:text="COPY KEY"
                    android:textColor="@color/screen_bg"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <View android:layout_width="7dp" android:layout_height="1dp" />
                <Button
                    android:id="@+id/btnRestoreKey"
                    android:layout_width="0dp"
                    android:layout_height="43dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_outline"
                    android:fontFamily="monospace"
                    android:text="IMPORT"
                    android:textColor="@color/text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
                <View android:layout_width="7dp" android:layout_height="1dp" />
                <Button
                    android:id="@+id/btnRotateKey"
                    android:layout_width="0dp"
                    android:layout_height="43dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_outline"
                    android:fontFamily="monospace"
                    android:text="ROTATE"
                    android:textColor="@color/text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="05  /  PRIVACY CONTRACT"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="NO ACCESSIBILITY SCRAPING\nNO NOTIFICATION LISTENER\nNO APP USAGE HISTORY\nNO SENSITIVE APP PRESENCE"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="2dp"
                android:text="Android tracking reports only the selected foreground app label. Usage Access cannot read a film or song title from another app. Rich media details require a supported app-owned integration; protected apps remain blocked."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="GPB  /  LOCAL FIRST  /  ANDROID + GECKO"
            android:textColor="@color/text_muted"
            android:textSize="9sp" />
    </LinearLayout>
</ScrollView>
