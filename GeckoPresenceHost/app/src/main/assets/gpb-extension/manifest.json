{
  "manifest_version": 2,
  "name": "Gecko Presence Bridge",
  "version": "0.5.0",
  "description": "Hybrid PreMiD-compatible and GPB-native activity adapters with a privacy-first Android bridge.",
  "permissions": [
    "tabs",
    "storage",
    "http://127.0.0.1:32145/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true,
    "browser_style": false
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false,
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content/youtube-media.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "gecko-presence@example.local",
      "strict_min_version": "112.0"
    },
    "gecko_android": {
      "strict_min_version": "112.0"
    }
  },
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
